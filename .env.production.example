# ==============================================================================
# تنظیمات محیط پروداکشن (Production Environment) برای انجمن علمی UISACE
# این فایل را به نام .env کپی کرده و مقادیر حساس را تغییر دهید:
# cp .env.production.example .env
# ==============================================================================

# کلید رمزنگاری توکن‌های JWT (حتماً یک رشته رندوم و طولانی قرار دهید)
JWT_SECRET=super_secret_jwt_random_string_replace_in_production_2026

# نام کاربری پنل ادمین
ADMIN_USERNAME=admin

# رمز عبور پنل ادمین
ADMIN_PASSWORD=change_this_strong_password_123

# آدرس پایه سایت
BASE_URL=https://sace.ui.ac.ir
